#! /usr/bin/env python3
"""Script for reading and anaylzing EinSpline HDF archives."""

# Python standard library imports

import sys
from argparse import ArgumentParser
from dataclasses import dataclass
from pathlib import Path

if sys.version_info[0:3] < (3, 10, 0):
    v = sys.version_info[0:3]
    print(
       f"Your version of Python ({v[0]}.{v[1]}.{v[2]}) is less than the minimum required for Nexus!\n"
        "To use Nexus, please install at least Python 3.10.0 or higher!\n\n"
        "If you already have a higher version installed, ensure that your Python\n"
        "environment is properly activated and your $PATH is set correctly."
    )
    sys.exit(1)

# Non-standard Python library imports
import numpy as np
import numpy.typing as npt

# Copied from qmca. Modification must done on qmca first
# Locate and import the closely coupled Nexus module
search_basepath = Path(__file__).resolve().parent.parent
nexus_library_search_path = search_basepath.parent
def find_nexus_modules():
    import sys

    # "import nexus" will succeed if nexus directory exists without __init__.py in it.
    # Explicitly check the existence of nexus/__init__.py at the closely coupled location
    nexus_init = nexus_library_search_path / 'nexus/__init__.py'
    if not nexus_init.exists():
        print(
            '\n'
            'Expected file '+str(nexus_init)+' does not exist!\n'
            'Broken Nexus installation! Please follow Nexus manual regarding installation.\n')
        sys.exit(1)

    # check import of nexus modules
    sys.path.insert(0,str(nexus_library_search_path))
    try:
        import nexus
    except Exception as err:
        print('\nImporting Nexus modules failed for an unknown reason.'
              '\nThis is likely a developer error.'
              '\nFor more information, the original exception is reproduced below.'
              '\nPlease report this error to the Nexus developers.'+2*'\n')
        import traceback
        exc_type, exc_value, exc_traceback = sys.exc_info()
        exc_lines = traceback.format_exception(exc_type, exc_value, exc_traceback)
        for line in exc_lines:
            print(line.rstrip())
        print()
        sys.exit(1)

    # Sanity check. Most likely errors get caught earlier.
    # ensure closely coupled nexus module is in use.
    nexus_lib2 = Path(nexus.__file__).resolve().parent.parent
    if nexus_library_search_path != nexus_lib2:
        exe_full_path = Path(sys.argv[0]).resolve()
        print('\nNexus executable ' + str(exe_full_path) +
              '\n  Executable derived <nexus_root> = ' + str(nexus_library_search_path) +
              '\n  Module     derived <nexus_root> = ' + str(nexus_lib2) +
              '\nNexus executables and modules are not from the same installation!\n')
        sys.exit(1)
#end def find_nexus_modules

# Load Nexus modules
find_nexus_modules()
from nexus.developer import log, warn
from nexus.hdfreader import read_hdf
from nexus.nexus_version import nexus_version
from nexus.unit_converter import convert


@dataclass
class KpointInfo:
    kpoint: npt.NDArray[np.floating]
    kin: npt.NDArray[np.floating]
    eig: npt.NDArray[np.floating]
    k: npt.NDArray[np.floating]
    nk: npt.NDArray[np.floating]
    ne: float


@dataclass
class EshdfData:
    orbfile: Path
    E_fermi: float
    axes: npt.NDArray[np.floating]
    kaxes: npt.NDArray[np.floating]
    nkpoints: float
    nspins: float
    data: KpointInfo


def read_eshdf_nofk_data(
    filename: Path,
    E_fermi: float,
    ncore: int = 0,
    nval: int = -1,
    ) -> EshdfData:
    E_fermi    = E_fermi + 1e-8
    h          = read_hdf(filename,view=True)
    gvecs_unit = np.array(h.electrons.kpoint_0.gvectors)
    axes       = np.array(h.supercell.primitive_vectors)
    kaxes      = 2*np.pi*np.linalg.inv(axes).T
    gvecs      = gvecs_unit @ kaxes
    kmag       = np.sqrt((gvecs**2).sum(1))
    nkpts      = np.asarray(h.electrons.number_of_kpoints, dtype=int)[0]
    nspins     = np.asarray(h.electrons.number_of_spins, dtype=int)[0]
    data       = {}
    for k in range(nkpts):
        kpt_idx  = f"kpoint_{k}"
        kp = h.electrons[kpt_idx]
        gvs = np.dot(np.array(kp.reduced_k),kaxes)
        gvecs_at_k = gvecs.copy()
        for d in range(3):
            gvecs_at_k[:,d] += gvs[d]

        kinetic=(gvecs_at_k**2).sum(1)/2 # Hartree units
        for s in range(nspins):
            spin_idx = f"spin_{s}"
            kin_s = []
            eig_s = []
            k_s   = gvecs_at_k
            nk_s  = 0*kmag
            nelec_s = 0
            spin = h["electrons"][kpt_idx][spin_idx]
            eig = convert(np.array(spin["eigenvalues"]),'Ha','eV')
            nst = np.asarray(spin["number_of_states"], dtype=int)[0]
            nlast = nst
            if nval > 0:
              nlast = ncore + nval
            for st in range(ncore, nlast):
                e = eig[st]
                if e<E_fermi:
                    state_idx = f"state_{st}"
                    psi = np.array(h["electrons"][kpt_idx][spin_idx][state_idx]["psi_g"])
                    nk_orb = (psi**2).sum(1)
                    kin_orb = (kinetic*nk_orb).sum()
                    nelec_s += nk_orb.sum()
                    nk_s += nk_orb
                    kin_s.append(kin_orb)
                    eig_s.append(e)

            data[k,s] = KpointInfo(
                kpoint = np.array(kp.reduced_k),
                kin    = np.array(kin_s),
                eig    = np.array(eig_s),
                k      = k_s,
                nk     = nk_s,
                ne     = nelec_s,
                )

    res = EshdfData(
        orbfile  = filename,
        E_fermi  = E_fermi,
        axes     = axes,
        kaxes    = kaxes,
        nkpoints = nkpts,
        nspins   = nspins,
        data     = data,
        )
    return res
#end def read_eshdf_nofk_data


def kinetic(
    eshdf_filepath: Path,
    *,
    E_fermi: float,
    ncore: int,
    nval: int,
    norm_tol: float,
    orb_info: bool,
    ):

    d = read_eshdf_nofk_data(
        eshdf_filepath,
        E_fermi,
        ncore=ncore,
        nval=nval
        )

    nkpoints = d.nkpoints
    nspins   = d.nspins

    ktot  = 0.0
    nspin = np.zeros((nspins,),dtype=int)
    kspin = np.zeros((nspins,),dtype=float)
    normspin = np.zeros((nspins,),dtype=float)
    norb  = []
    korb  = []
    eorb  = []
    kpidx= []
    for s in range(nspins):
        nsorb = []
        ksorb = []
        esorb = []
        kpsidx = []
        for k in range(nkpoints):
            dks = d.data[k,s]
            nsorb.append(len(dks.kin))
            ksorb.extend(dks.kin)
            esorb.extend(dks.eig)
            kpsidx.extend([k]*len(dks.kin))
            normspin[s] += dks.ne

        nsorb = np.array(nsorb,dtype=int)
        ksorb = np.array(ksorb,dtype=float)
        esorb = np.array(esorb,dtype=float)
        kpsidx = np.array(kpsidx,dtype=int)

        order = esorb.argsort()
        esorb = esorb[order]
        ksorb = ksorb[order]
        kpsidx = kpsidx[order]

        ns = nsorb.sum()
        ks = ksorb.sum()

        ktot    += ks
        nspin[s] = ns
        kspin[s] = ks
        norb.append(nsorb)
        korb.append(ksorb)
        eorb.append(esorb)
        kpidx.append(kpsidx)

    def arr2str(a):
        return f'{a}'.strip().strip('[]')

    print(f'\nNumber of spins              : {nspins}')
    print(f'Number kpoints               : {nkpoints}')
    print(f'Number of electrons per spin : {arr2str(nspin)}')
    print(f'Summed orbital norm per spin : {arr2str(normspin)}')
    print(f'Total kinetic energy         : {ktot} Ha')
    print(f'Kinetic energy per spin      : {arr2str(kspin)} Ha')

    norm_diff = np.abs(normspin-nspin).max()
    if norm_diff>norm_tol:
        warn(
            'Orbitals are not properly normalized!\n'
            f'Error in the summed norm is: {norm_diff}\n'
            f'This exceeds a tolerance of: {norm_tol:e}'
            )

    if not orb_info:
        return # Early return to reduce indentation later

    print('\nPer orbital kinetic energies')
    for s in range(nspins):
        spin = "up" if s == 0 else "down"

        print(f'  Spin {spin} energies')
        print(
            '    '
            f'{"index":>5}'
            f'{"kpoint_index":^14}'
            f'{"KS eig (eV)":^13}'
            f'{"kinetic (Ha)":>13}'
        )
        for i,(kpi,eig,kin) in enumerate(zip(kpidx[s], eorb[s], korb[s], strict=True)):
            print(
                '    '
                f'{i:^5}'
                f'{kpi:^14}'
                f'{eig:>11.6f}'
                f'{kin:>13.6f}'
            )
#end def kinetic


def write_nk(
    eshdf_filepath: Path,
    E_fermi: float,
    ncore: int,
    nval: int,
    ispin0: int,
    outfile: Path,
    ):
    d = read_eshdf_nofk_data(
        filename = eshdf_filepath,
        E_fermi       = E_fermi,
        ncore    = ncore,
        nval     = nval,
        )

    log(f'Writing n(k) to HDF5 {outfile}')
    import tables
    klist = []
    nklist = []
    for key, val in d.data.items():
        _, ispin = key
        if ispin != ispin0:
            continue
        klist.append(val.k)
        nklist.append(val.nk)
    kvecs = np.concatenate(klist, axis=0)
    nk = np.concatenate(nklist, axis=0)
    data = np.c_[kvecs, nk]
    filters = tables.Filters(complevel=5, complib='zlib')
    fp = tables.open_file(outfile, mode='w', filter=filters)
    atom = tables.Atom.from_dtype(data.dtype)
    ca = fp.create_carray(fp.root, 'data', atom, data.shape)
    ca[:] = data
    fp.close()
#end def write_nk


if __name__=='__main__':
    parser = ArgumentParser(prog="eshdf")
    parser.add_argument(
        "--version",
        action="version",
        version="%(prog)s {}.{}.{}".format(*nexus_version)
    )
    subparsers = parser.add_subparsers(
        title="Run Types",
        dest="run_type",
        required=True,
    )

    wnk_parser = subparsers.add_parser("write_nk")
    kin_parser = subparsers.add_parser("kinetic")

    for subparser in (wnk_parser, kin_parser):
        subparser.add_argument(
            "eshdf_file",
            type=Path,
            help="Path to HDF archive with data.",
        )
        subparser.add_argument(
            '--E-fermi',
            '--E_fermi',
            '--Ef',
            type=float,
            help='Fermi energy in eV.',
            required=True,
        )
        subparser.add_argument(
            '--ncore',
            type=int,
            default=0,
            help='Number of core states to exclude (default: %(default)s).',
        )
        subparser.add_argument(
            '--nval',
            type=int,
            default=-1,
            help='Number of valence states to include (default: %(default)s, i.e. all).',
        )

    kin_parser.add_argument(
        '--norm-tol',
        '--norm_tol',
        type=float,
        default=1e-6,
        help=(
            'Tolerance for whether or not the orbitals are considered normalized. '
            '(default: %(default)s).'
            ),
        )
    kin_parser.add_argument(
        '-o',
        '--orb',
        dest="orb_info",
        action='store_true',
        help=(
            'Print per orbital kinetic energies (default: %(default)s).'
            ),
        )

    wnk_parser.add_argument(
        '--outfile',
        '--output',
        type=Path,
        help='Output 3D momentum distribution to this file.',
        required=True,
        )
    wnk_parser.add_argument(
        '--ispin',
        type=int,
        default=0,
        help='Spin channel (default: %(default)s).',
        )

    args = parser.parse_args()
    arg_dict = vars(args)
    eshdf_file = args.eshdf_file.resolve(strict=True)
    if eshdf_file.suffix != '.h5':
        msg = (
            'File provided is not an HDF5 file.\n'
            'An ESHDF file must have a .h5 extension.\n'
            'Please check the path provided:\n'
            f'  {eshdf_file}'
            )
        raise ValueError(msg)

    match args.run_type:
        case "kinetic":
            kinetic(
                eshdf_filepath=eshdf_file,
                E_fermi=args.E_fermi,
                ncore=args.ncore,
                nval=args.nval,
                norm_tol=args.norm_tol,
                orb_info=args.orb_info,
            )
        case "write_nk":
            write_nk(
                eshdf_filepath=eshdf_file,
                E_fermi=args.E_fermi,
                ncore=args.ncore,
                nval=args.nval,
                ispin0=args.ispin,
                outfile=args.outfile,
            )
        case _:
            msg = "This should be unreachable code!"
            raise RuntimeError(msg)
#end if
